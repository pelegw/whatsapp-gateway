meta {
  name: Cancel scheduled draft
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/admin/drafts/{{draftId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

docs {
  Cancels a SCHEDULED send before it fires (409 for any other status). List them with GET /v1/admin/drafts?status=scheduled.
}
