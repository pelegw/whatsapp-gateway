meta {
  name: 1 Initialize
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{agentKey}}
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-03-26",
      "capabilities": {},
      "clientInfo": { "name": "bruno", "version": "0" }
    }
  }
}

docs {
  Streamable-HTTP MCP handshake. Response is an SSE event carrying serverInfo.
}
