# Secrets — never commit. Ignore every .env variant but keep the templates.
.env
.env.*
!.env.example
!.env.production.example

# Databases / session credentials
*.db
*.db-wal
*.db-shm
data/
gwdata/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Go
sidecar/sidecar
*.exe

# Public-exposure secrets: ignore everything under edge/certs except its README.
edge/certs/*
!edge/certs/README.md
