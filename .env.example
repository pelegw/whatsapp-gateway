# Copy to .env and fill in. Generate tokens with:  openssl rand -hex 32

# Shared secret between gateway and sidecar (internal Docker network only).
SIDECAR_TOKEN=

# Human/admin token: approvals, key management, QR login proxy. Keep private.
ADMIN_TOKEN=

# Port the gateway publishes on 127.0.0.1 (agents + admin UI connect here).
GATEWAY_PORT=8080

# Name shown under WhatsApp > Linked devices (applied at pairing/re-link time).
DEVICE_NAME=WA_GW

# Timezone for logs and message timestamps display.
TZ=Asia/Jerusalem

# Optional: extra Host headers the /mcp endpoint should accept, e.g. when
# reaching the gateway through Tailscale: localhost:*,127.0.0.1:*,mybox:8080
#MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# =====================================================================
# Internet exposure behind Cloudflare (all optional; leave blank for a
# local-only run). Full setup steps are in the README.
# =====================================================================

# Public hostname Cloudflare proxies to your origin (Caddy). Used by the
# docker-compose.public.yml overlay.
#SITE_DOMAIN=wa.example.com

# Origin lockdown: a random secret a Cloudflare Transform Rule adds as the
# X-WAGW-Origin header on every request. The gateway (and Caddy) reject anything
# without it, so hitting the origin IP directly gets 403. Generate: openssl rand -hex 32
#ORIGIN_SECRET=
#ORIGIN_SECRET_HEADER=x-wagw-origin

# Cloudflare Access (Zero Trust) for the human management plane. When enabled,
# /v1/admin/* and /admin/approvals require BOTH a valid Access identity and the
# admin token above.
#CF_ACCESS_ENABLED=true
#CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
#CF_ACCESS_AUD=<Access application AUD tag>
#CF_ACCESS_ALLOWED_EMAILS=you@example.com

# Safety interlock: if ORIGIN_SECRET is set (public mode) but Cloudflare Access
# is NOT enabled, the gateway refuses to start (admin would be token-only).
# Set true ONLY if you deliberately accept admin-token-only protection.
#ALLOW_INSECURE_ADMIN=false
