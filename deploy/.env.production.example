# Production .env for the public (Cloudflare-fronted) deployment on EC2.
# Copy to the host as  /opt/wa-gw/.env  and fill EVERY value below.
# Generate the three secrets with:  openssl rand -hex 32

# --- core secrets -----------------------------------------------------------
SIDECAR_TOKEN=            # gateway <-> sidecar shared secret (internal only)
ADMIN_TOKEN=             # admin/management credential (second factor behind SSO)

# --- public hostname --------------------------------------------------------
SITE_DOMAIN=wa.example.com          # the proxied Cloudflare hostname for this box
DEVICE_NAME=WA_GW                   # shown in WhatsApp > Linked devices
TZ=Asia/Jerusalem

# --- origin lockdown (secret header injected by a Cloudflare Transform Rule) -
ORIGIN_SECRET=           # openssl rand -hex 32 ; also set in the CF Transform Rule
# ORIGIN_SECRET_HEADER=x-wagw-origin   # default is fine

# --- Cloudflare Access on the admin plane (REQUIRED in public mode) ----------
# The gateway REFUSES TO START if ORIGIN_SECRET is set but these are not, so the
# admin surface is never left on the token alone. (Override only with
# ALLOW_INSECURE_ADMIN=true, which you should not need.)
CF_ACCESS_ENABLED=true
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=            # the Access application's AUD tag (from its config)
CF_ACCESS_ALLOWED_EMAILS=you@example.com   # comma-separated allow-list
